# AI Radio - Environment Variables
# Copy this to .env and fill in your API keys

# Free LLM APIs (choose one)
# Kilo Gateway - https://kilo.sh (free tier available)
VITE_KILO_API_KEY=

# OpenCode AI - https://opencode.ai (free tier available)
# VITE_OPENCODE_API_KEY=

# Google Gemini - https://aistudio.google.com
# VITE_GEMINI_API_KEY=

# Edge TTS token (optional, public token included by default)
# VITE_EDGE_TTS_TOKEN=6A5AA1D4EAFF4E9FB37E23D68491D6F4

# Default voice for TTS (optional, defaults to de-DE-KillianNeural)
# German voices: de-DE-KillianNeural, de-DE-ConradNeural, de-DE-FreyaNeural, de-DE-KatjaNeural
# English voices: en-US-GuyNeural, en-US-JennyNeural
# VITE_DEFAULT_VOICE=de-DE-KillianNeural