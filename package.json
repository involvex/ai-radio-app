		"@tauri-apps/cli": "^2.0.0",
		"@tsconfig/svelte": "^5.0.4",
		"eslint": "^10.6.0",
		"globals": "^17.7.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.4",
