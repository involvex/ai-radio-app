{
	"$schema": "https://schema.tauri.app/config/2",
	"identifier": "default",
	"description": "Default capabilities for AI Radio",
	"windows": ["main"],
	"permissions": [
		"core:default",
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "binaries/llama-server",
					"sidecar": true,
					"args": true
				}
			]
		},
		"shell:allow-spawn",
		"shell:allow-kill"
	]
}
