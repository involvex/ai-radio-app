{
	"$schema": "https://schema.tauri.app/config/2",
	"identifier": "default",
	"description": "Default capabilities for AI Radio",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"shell:allow-execute",
		"shell:allow-spawn",
		"shell:allow-kill",
		"dialog:allow-open",
		"dialog:allow-save",
		"dialog:allow-ask",
		"dialog:allow-message"
	]
}
